{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 80,
  "singleQuote": true,
  "semi": false,
  "tabWidth": 2,
  "useTabs": false,
  "ignorePatterns": [
    "node_modules/**",
    "main.js",
    "package-lock.json",
    "assets/**",
    ".git/**",
    ".github/**",
    ".vscode/**",
    "*.json",
    "*.yml",
    "*.yaml",
  ]
}
